#!/usr/bin/env bash
###############################################################################
##
## hl - simple text highlighter (literal + regex support)
##
## DESCRIPTION:
##   Reads stdin and highlights matching text using ANSI colors.
##
##   Supports two modes:
##     1. Literal match (default)
##        hl word:red
##
##     2. Regex match (wrap pattern in /.../)
##        hl '/H[0-9]/':blue
##
## USAGE:
##   echo "text" | hl pattern:color [pattern:color ...]
##
## EXAMPLES:
##   echo "The car is an H1 model" | hl car:red
##   echo "The car is an H1 model" | hl '/H[0-9]/':blue
##   echo "The car is an H1 model" | hl car:red model:green '/H[0-9]/':blue
##   echo "meeting at 09:30"       | hl '/[0-9]\{2\}:[0-9]\{2\}/':bcyan
##   echo "cat and dog"            | hl '/cat\|dog/':yellow
##
## COLORS:
##   black, red, green, yellow, blue, magenta, cyan, white
##   bright_red, bright_green, bright_yellow, bright_blue,
##   bright_magenta, bright_cyan
##   All bright_COLOR colors can use alias of bCOLOR (bright_red == bred).
##
## NOTES:
##   - Regex uses sed BRE syntax (not PCRE). \| \+ \? are GNU extensions
##     and will not work on BSD/macOS sed.
##   - Literal mode escapes all BRE metacharacters, so 'a.b' matches only
##     the three-character string "a.b".
##   - Patterns may contain ':' - the color is taken from the LAST colon.
##   - Patterns are applied in order; overlapping matches nest, and the
##     outer color is restored when an inner highlight ends.
##
## KNOWN LIMITATIONS:
##   - A '$' anchor in a later pattern may not match if an earlier pattern
##     already highlighted the end of the line.
##   - Patterns using '.' or negated classes like '[^x]' can match the
##     internal marker bytes used to track highlights.
##   - The /.../ syntax is ambiguous with paths: '/usr/:red' is read as the
##     regex 'usr', not the literal string "/usr/". Escape the slashes
##     ('\/usr\/:red') or match a substring instead.
##   - Any number of pattern:color pairs may be given; the only ceiling is
##     15 distinct colors, which is the whole palette.
##
###############################################################################

__author__="github.com/bytebeast"

set -euo pipefail

###############################################################################
## Internal marker bytes
##
## Highlights are inserted as single non-printing marker bytes, then rendered
## to ANSI escapes in one final pass. This stops later patterns from matching
## the printable characters of escape codes emitted by earlier patterns
## (e.g. '/[0-9]/' matching the "31" inside "\033[0;31m").
##
## One mark is allocated per DISTINCT COLOR, not per pattern, so the number
## of pattern:color pairs is unbounded. MARKS holds 16 bytes and the palette
## defines 15 colors, so the limit below cannot be reached without first
## adding a new color to get_color().
##
## Every byte below must be distinct, non-printing, and covered by STRIP.
## Octal escapes only accept digits 0-7: '\038' is NOT byte 038, bash reads
## it as '\003' followed by a literal '8'. '\040' is a space. Do not extend
## MARKS past '\037' with escapes of that form.
##
## Free bytes if more marks are ever needed: \001-\003 and \010.
## Reserved and unusable: \000, \011 (tab), \012 (newline), \015 (CR),
## \033 (ESC) and \016 \017 (SO/SI) - all three appear inside terminfo
## sequences such as `tput sgr0`.
###############################################################################
CLOSE=$'\020'                                                             # ends a highlight
MARKS=$'\004\005\006\007\013\014\021\022\023\024\025\026\027\030\031\032' # one per color (16)
SEP=$'\036'                                                               # color-list separator
D=$'\037'                                                                 # sed s/// delimiter
STRIP='\004-\007\013\014\020-\032\034-\037'                               # scrubbed from input

MAX_COLORS=${#MARKS}

usage() {
    sed -n '3,50p' "$0" | sed 's/^#*//; s/^ //'
    exit "${1:-0}"
}

die() {
    printf 'hl: %s\n' "$1" >&2
    exit 2
}

###############################################################################
## Color setup (tput or ANSI)
###############################################################################
if command -v tput >/dev/null 2>&1 && tput setaf 1 >/dev/null 2>&1; then
    RESET=$(tput sgr0)
    BOLD=$(tput bold)

    BLACK=$(tput setaf 0)
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    MAGENTA=$(tput setaf 5)
    CYAN=$(tput setaf 6)
    WHITE=$(tput setaf 7)

    BRIGHT_BLACK=$BOLD$BLACK
    BRIGHT_RED=$BOLD$RED
    BRIGHT_GREEN=$BOLD$GREEN
    BRIGHT_YELLOW=$BOLD$YELLOW
    BRIGHT_BLUE=$BOLD$BLUE
    BRIGHT_MAGENTA=$BOLD$MAGENTA
    BRIGHT_CYAN=$BOLD$CYAN
    BRIGHT_WHITE=$BOLD$WHITE
else
    RESET=$'\033[0m'
    BOLD=$'\033[1m'

    BLACK=$'\033[0;30m'
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    MAGENTA=$'\033[0;35m'
    CYAN=$'\033[0;36m'
    WHITE=$'\033[0;37m'

    BRIGHT_BLACK=$'\033[1;30m'
    BRIGHT_RED=$'\033[1;31m'
    BRIGHT_GREEN=$'\033[1;32m'
    BRIGHT_YELLOW=$'\033[1;33m'
    BRIGHT_BLUE=$'\033[1;34m'
    BRIGHT_MAGENTA=$'\033[1;35m'
    BRIGHT_CYAN=$'\033[1;36m'
    BRIGHT_WHITE=$'\033[1;37m'
fi

###############################################################################
## Color resolver - returns non-zero for an unknown name
###############################################################################
get_color() {
    case "$1" in
        black) printf '%s' "$BLACK" ;;
        red) printf '%s' "$RED" ;;
        green) printf '%s' "$GREEN" ;;
        yellow) printf '%s' "$YELLOW" ;;
        blue) printf '%s' "$BLUE" ;;
        magenta) printf '%s' "$MAGENTA" ;;
        cyan) printf '%s' "$CYAN" ;;
        white) printf '%s' "$WHITE" ;;

        bright_black | bblack) printf '%s' "$BRIGHT_BLACK" ;;
        bright_red | bred) printf '%s' "$BRIGHT_RED" ;;
        bright_green | bgreen) printf '%s' "$BRIGHT_GREEN" ;;
        bright_yellow | byellow) printf '%s' "$BRIGHT_YELLOW" ;;
        bright_blue | bblue) printf '%s' "$BRIGHT_BLUE" ;;
        bright_magenta | bmagenta) printf '%s' "$BRIGHT_MAGENTA" ;;
        bright_cyan | bcyan) printf '%s' "$BRIGHT_CYAN" ;;
        bright_white | bwhite) printf '%s' "$BRIGHT_WHITE" ;;

        *) return 1 ;;
    esac
}

###############################################################################
## Escape a literal string for use as a BRE
##
## Escapes every BRE metacharacter: \ . * [ ^ $
## ']' needs no escaping because '[' is already escaped, so no bracket
## expression can ever be opened.
###############################################################################
escape_bre() {
    printf '%s' "$1" | sed 's/[\.*^$[]/\\&/g'
}

###############################################################################
## Parse arguments
###############################################################################
[[ $# -eq 0 ]] && {
    [[ -t 0 ]] && usage 0
    exec cat
}

case "${1:-}" in
    -h | --help) usage 0 ;;
esac

###############################################################################
## Colors are interned: repeated colors reuse the same mark, so 40 patterns
## sharing 3 colors need only 3 marks. Linear search keeps this bash 3.2 safe
## (no associative arrays).
###############################################################################
sed_args=()
colors=""
color_codes=()

color_index() {
    local i
    for ((i = 0; i < ${#color_codes[@]}; i++)); do
        [[ ${color_codes[i]} == "$1" ]] && {
            printf '%s' "$((i + 1))"
            return 0
        }
    done
    return 1
}

for pair in "$@"; do
    [[ "$pair" == *:* ]] || die "missing color in '$pair' (expected pattern:color)"

    # Split on the LAST colon so patterns may contain colons.
    word=${pair%:*}
    color=${pair##*:}

    [[ -n "$word" ]] || die "empty pattern in '$pair'"

    code=$(get_color "$color") || die "unknown color '$color' in '$pair'"

    # Strip marker bytes a user could otherwise inject.
    word=$(printf '%s' "$word" | tr -d "$STRIP")

    # Regex mode: /pattern/ - needs at least one character between slashes.
    if [[ ${#word} -ge 3 && "$word" == /*/ ]]; then
        pattern=${word#/}
        pattern=${pattern%/}
    else
        pattern=$(escape_bre "$word")
    fi

    # Reuse this color's mark if seen before, otherwise allocate the next one.
    if ! cidx=$(color_index "$code"); then
        [[ ${#color_codes[@]} -lt $MAX_COLORS ]] ||
            die "too many distinct colors (max $MAX_COLORS)"
        color_codes+=("$code")
        cidx=${#color_codes[@]}
        colors+="${code}${SEP}"
    fi

    mark=${MARKS:cidx-1:1}
    sed_args+=(-e "s${D}${pattern}${D}${mark}&${CLOSE}${D}g")
done

###############################################################################
## Apply highlights
##
## One streaming pipeline: scrub markers, run every substitution in a single
## sed pass, then resolve markers to ANSI codes with a color stack so nested
## highlights restore the enclosing color instead of clearing it.
###############################################################################
tr -d "$STRIP" |
    sed "${sed_args[@]}" |
    awk -v marks="$MARKS" -v cl="$CLOSE" -v sep="$SEP" \
        -v cols="$colors" -v reset="$RESET" '
    BEGIN { split(cols, C, sep); re = "[" marks cl "]" }
    {
        line = $0; out = ""; d = 0
        while (match(line, re)) {
            out = out substr(line, 1, RSTART - 1)
            ch  = substr(line, RSTART, 1)
            if (ch == cl) {
                if (d > 0) d--
                out = out (d > 0 ? C[st[d]] : reset)
            } else {
                st[++d] = index(marks, ch)
                out = out C[st[d]]
            }
            line = substr(line, RSTART + 1)
        }
        print out line
    }'
